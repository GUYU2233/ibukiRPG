# 复制为 .env 后填写。切勿提交真实密钥。
# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# 阿里云百炼 / DashScope（Qwen，OpenAI 兼容模式）
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
# 通用 OpenAI 兼容端点，例如 https://api.deepseek.com/v1 或 https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
